# Copy to .env.local and fill in. Never commit the real file.

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/env-vault

# 32-byte key for AES-256-GCM. Generate with: openssl rand -base64 32
# Losing or changing this key makes every stored value unreadable.
ENCRYPTION_KEY=

# Google OAuth client (Web application) from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app, used to build the OAuth redirect URI
APP_URL=http://localhost:3000

# Comma-separated Google emails allowed to sign in, e.g. you@gmail.com
# Use * only if you really want any Google account to create its own vault.
ALLOWED_EMAILS=
